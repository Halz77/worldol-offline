# ==========================================================================
# 世界OL 单机版 —— 版本控制忽略清单
#
# 原则：只忽略「第三方只读归档 / 依赖 / 运行时状态 / 构建产物 / 临时目录」。
#       凡是人手改得动、需要能 diff 与回滚的东西（lib/ tools/ tests/ web/
#       data/ 以及脚本与文档）都纳入版本控制。
#
# 注意：.gitignore 不支持行内注释 —— "#" 只有出现在行首才算注释。
#       所以下面每条规则的说明都单独占一行。
# ==========================================================================

# ---- 原版第三方归档与反编译产物（体积大、只读、不从这里改）---------------
# client/  148MB：原版 H5 客户端归档。其中 v/gd/305.json 由测试按 sha256 守着
#                  字节不变，补丁一律在内存里打，不落盘。
# analysis/ 15MB：由 client/ 反编译得到，gd.decoded.js 是引导补丁的锚点来源。
世界online_原版单机/client/
世界online_原版单机/analysis/

# ---- 依赖 ----------------------------------------------------------------
**/node_modules/

# ---- 运行时状态（存档 / 日志 / 备份 / 临时运行目录）---------------------
世界online_原版单机/saves/
世界online_原版单机/logs/
世界online_原版单机/backups/
世界online_原版单机/runtime/
世界online_原版单机/control.json

# ---- 测试临时目录 --------------------------------------------------------
# 测试用例已改为在 os.tmpdir() 下落盘，这两条只是兜底，
# 防止早期版本遗留在仓库根的目录被带进版本库。
世界online_原版单机/test-captured-expansion-*/
世界online_原版单机/test-save-check-*/
test-captured-expansion-*/
test-save-check-*/

# ---- 安卓打包产物 --------------------------------------------------------
# www 是 standalone/build.mjs 生成的站点输出（把 client/ 平铺进来那一步）。
安卓打包/app/www/
安卓打包/app/android/build/
安卓打包/app/android/.gradle/
安卓打包/app/android/app/build/
# 本机 SDK/NDK 路径，换机器就没用。
安卓打包/app/android/local.properties
安卓打包/**/*.apk
安卓打包/**/*.aab
安卓打包/**/*.keystore
安卓打包/**/*.jks
安卓打包/**/keystore.properties
安卓打包/build.log
安卓打包/build-last.txt
安卓打包/诊断/*.log
# 一键打包.bat 的归档输出（每个包 100MB+，只留最近几个）。
安卓打包/output/

# ---- 杂项工作区 ----------------------------------------------------------
# 临时草稿目录，不参与交付。
.scratch/

# ---- 编辑器 / 系统噪声 ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
