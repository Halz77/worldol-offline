[{"id":10,"name":"圣域（中立城市）","info":"这是25级的NPC(电脑控制)中立城市地图。通过这个地图可以乘坐飞行驿站免费前往绝望冰原、远古森林、夜语森林等地图。神圣之光笼罩着域城的天空，净化一切邪恶，令到域外一些强大的妖魔望而却步。","state":0,"isNeedItem":0,"sources":[{"seq":7764,"protocol":10522,"sha256":"fffb695d305662d6ec04e0469acd338eb8363b60ac9e584c5cbf29b09740616f","blob":"blobs/ff/fffb695d305662d6ec04e0469acd338eb8363b60ac9e584c5cbf29b09740616f.bin","areaId":3,"requestSeq":7763},{"capture":"2026-09-19T23-46-03-133Z_d6e6ad","seq":7764,"protocol":10522,"sha256":"fffb695d305662d6ec04e0469acd338eb8363b60ac9e584c5cbf29b09740616f","blob":"blobs/ff/fffb695d305662d6ec04e0469acd338eb8363b60ac9e584c5cbf29b09740616f.bin","areaId":3,"requestSeq":7763},{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":66001,"protocol":10522,"sha256":"a37a96edbdcea7bc1aeb550163a5f651453dfe6b10a68969238e92104137687e","blob":"blobs/a3/a37a96edbdcea7bc1aeb550163a5f651453dfe6b10a68969238e92104137687e.bin","areaId":3,"requestSeq":66000}]}]