[{"id":56,"name":"蒂卡尔（中立城市）","info":"蒂卡尔是玛雅文明中最大的遗弃都市。文明的光芒虽然已经暗淡，但是生活在这里的人们散发着名为幸福的另一种光芒。也许在这里居住下来会邂逅一场仙人掌花开。/c00FF00进入地图需要角色达到50级。/p","state":0,"isNeedItem":1,"sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":69668,"protocol":10522,"sha256":"dc9cd1bd6f8999893e79d3261e451662b1ad0ecf1571ad04481c53ecc5b8d16a","blob":"blobs/dc/dc9cd1bd6f8999893e79d3261e451662b1ad0ecf1571ad04481c53ecc5b8d16a.bin","areaId":15,"requestSeq":69667}]}]