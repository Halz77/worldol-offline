[{"id":2775,"name":"新年发红包","level":0,"simpleDesc":"谷得的员工分散在各个主要城市和地图中。努力找他们出来吧。 分别是雷斯林、涛哥、许总、轩姐、悲剧哥、镇洪哥、肥东海、冰哥。","desc":"谷得全体员工祝各位玩家新年快乐，祝所有在校学子学业进步。祝所有的军人玩家，身体健康。感谢你们守卫我们的家园。祝所有工作中的玩家，步步高升，财源滚滚。在这个新春佳节，我们将向每位60级以上的玩家，发放红包。每天都可以来领取哦。拿红包的方法很简单，谷得的员工会分散在各个主要城市和地图中，找寻到他们，就可以领取谷得祝福。收集到8张祝福，就可以换取红包了。每天都可以来领取哦。","setting":2,"mapId":14,"npcId":10,"radarMapID":0,"dialogNotStartNotReady":"60级以上玩家可参加！","dialogStartNotFinish":"谷得的员工分散在各个主要城市和地图中。努力找他们出来吧。","dialogStartFinish":"谢谢你一直以来对世界OL的支持，这些是我们赠送的礼品。小小心意。","exp":0,"money2":0,"money3":0,"rewardItems":[{"illusion":[],"id":1405,"quantity":1,"name":"春节红包","bagIcon":7,"grade":3}],"selectItems":[{"illusion":[],"id":801,"quantity":1,"name":"年年如意","bagIcon":29,"grade":3,"type":28},{"illusion":[],"id":802,"quantity":1,"name":"岁岁平安","bagIcon":29,"grade":3,"type":28},{"illusion":[],"id":805,"quantity":1,"name":"万事顺心","bagIcon":29,"grade":3,"type":28}],"acceptCondition":[{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"3c","minimum":60},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":7,"typeName":"CONDITION_HAVE_ITEM","not":0,"rawHex":"000003340015e8b0b7e5be97e59198e5b7a5e79a84e7a59de7a68f08","itemId":820,"name":"谷得员工的祝福","required":8},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":14,"acceptNpcId":10,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"seq":5013,"protocol":14501,"sha256":"d6a23189f1dadb9add2980c0c1914c12e7fbcd2e7b982ec97027b0bd894c82db","blob":"blobs/d6/d6a23189f1dadb9add2980c0c1914c12e7fbcd2e7b982ec97027b0bd894c82db.bin","npcId":10,"mapId":14},{"capture":"2026-09-19T23-46-03-133Z_d6e6ad","seq":5013,"protocol":14501,"sha256":"d6a23189f1dadb9add2980c0c1914c12e7fbcd2e7b982ec97027b0bd894c82db","blob":"blobs/d6/d6a23189f1dadb9add2980c0c1914c12e7fbcd2e7b982ec97027b0bd894c82db.bin","npcId":10,"mapId":14},{"c