[{"id":3042,"name":"恶梦爆破","level":0,"simpleDesc":"消灭所有的南瓜爆弹。这些东西会在第五、第八、第十回合开始自爆。要小心,每一个南瓜都有不同的特性。如果你不能在限定时间内破坏他们。每一个自爆都会要你们命。","desc":"我最喜欢万圣节，只有这一个节日！！才是我的的最爱。我不会让这个节日消失的。看到这些南瓜了吗？看到这满世界的南瓜了吗？他们都是我所放的炸弹！！想办法拆除这些炸弹吧！！哈哈！你没有多少时间。哈哈哈。/c00FF00消灭所有的南瓜爆弹。这些东西会在第五、第八、第十回合自爆。要小心,每一个南瓜都有不同的特性。如果你不能在限定时间内破坏他们。每一个自爆都会要你们命。/p","setting":1026,"mapId":259,"npcId":8,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"/c00FF00消灭所有的南瓜爆弹。这些东西会在第五、第八、第十回合自爆。要小心,每一个南瓜都有不同的特性。如果你不能在限定时间内破坏他们。每一个自爆都会要你们命。/p","dialogStartFinish":"我不甘心。。。。我喜欢万圣节，我喜欢南瓜。。。/c00FF00随着这个可怕的园丁死去，恶梦似乎已消去，为什么一个园丁疯狂的概念会成为这样的恶梦？你不太清楚，你只知道，事情未结束。/p","exp":5000,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":10007,"submitBattleID":0,"submitNextMissionID":0,"rewardItems":[{"illusion":[],"id":1381,"quantity":1,"name":"万圣节的恶梦奖励","bagIcon":7,"grade":3},{"illusion":[],"id":716,"quantity":5,"name":"世界骑士勋章","bagIcon":20,"grade":2}],"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0be1000ce681b6e6a2a6e5bbb6e7bbad","missionId":3041,"name":"恶梦延续"},{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"2d","minimum":45},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":2,"typeName":"CONDITION_KILL_MONSTER","not":0,"rawHex":"07c1000fe680aae5bc82e79a84e59bade4b8810100","monsterId":1985,"name":"怪异的园丁","required":1,"current":0},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0be00006e681b6e6a2a6","missionId":3040,"name":"恶梦"},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0be1000ce681b6e6a2a6e5bbb6e7bbad","missionId":3041,"name":"恶梦延续"}],"type":3,"series":"微笑南瓜","acceptMapId":259,"acceptNpcId":8,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":69260,"protocol":14501,"sha256":"12aff3b914b689ba2b60b2caea09d62a9d157ba2227641a9a141eb7f93299298","blob":"blobs/12/12aff3b914b689ba2b60b2caea09d62a9d157ba2227641a9a141eb7f93299298.bin