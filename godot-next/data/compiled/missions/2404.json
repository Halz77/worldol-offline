[{"id":2404,"name":"领取基础魔石（日常任务）","level":0,"simpleDesc":"打败炼药大师","desc":"打开背包，点击附魔可吸收蓝色、橙色、紫色装备获得附魔值。装备等级越高，获得的附魔值也越高。但是如果人物与装备等级相差太大，则只能得到一部分附魔值。另外合成附魔道具需要基础魔石，只要你打败炼药大师，我就送给你两个。其他的你可以通过开启高级合成材料箱获得。","setting":2,"mapId":960,"npcId":14,"radarMapID":0,"dialogNotStartNotReady":"该任务需要55级以上才可以接","dialogStartNotFinish":"你还没打败炼药大师呢？炼药大师在卡斯蒂略金字塔，接取玛雅第一阶段任务就会遇到他。","dialogStartFinish":"每件装备只能附魔一次，如果重新附魔，则会覆盖上一次的属性，尽量使用高级的附魔道具附魔吧。","exp":0,"money2":0,"money3":0,"rewardItems":[{"illusion":[],"id":1063,"quantity":2,"name":"基础魔石","bagIcon":33,"grade":3}],"acceptCondition":[{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"32","minimum":50},{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"37","minimum":55},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":2,"typeName":"CONDITION_KILL_MONSTER","not":0,"rawHex":"0c94000ce782bce88dafe5a4a7e5b8880100","monsterId":3220,"name":"炼药大师","required":1,"current":0},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":960,"acceptNpcId":14,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":69715,"protocol":14501,"sha256":"ef6bcc1c0bb562480914b939ca13796bf3295cdbe74096d0407e9c731b3ef887","blob":"blobs/ef/ef6bcc1c0bb562480914b939ca13796bf3295cdbe74096d0407e9c731b3ef887.bin","npcId":14,"mapId":960}]}]