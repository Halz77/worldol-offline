[{"id":384,"name":"盗墓一族","level":0,"simpleDesc":"","desc":"我们盗墓一族找了千百年的东西，如今就近在眼前，因为区区几具骷髅和干尸就要我半途而废？不可能！","setting":1027,"mapId":813,"npcId":5,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"我要找的只是一本延寿的秘籍，对你来说毫无价值。如果你能帮我到达墓底，古墓里的陪葬品统统归你。如何？这绝对是一宗合算的交易。","exp":100,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":385,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"017f0006e8afb7e6b182","missionId":383,"name":"请求"}],"type":0,"series":"","acceptMapId":813,"acceptNpcId":5,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":10686,"protocol":14501,"sha256":"3973936f094d08c673b976876eadeaa0a3f0a4db6bd54b34ad885567861baa53","blob":"blobs/39/3973936f094d08c673b976876eadeaa0a3f0a4db6bd54b34ad885567861baa53.bin","npcId":5,"mapId":813}]}]