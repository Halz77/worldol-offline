[{"id":917,"name":"朱雀石的秘密","level":0,"simpleDesc":"","desc":"哈哈，/c00FF00其实世上本没有朱雀石/p，那只是邪恶之人的谣言。传说古时朱雀在飞翔时，途经此地，见这里风景极美，便在这里歇息片刻。它身覆火焰，终日不熄，甚是高贵。路过的人见了无不为它的风姿所迷倒，大家都认为这是吉兆，便把这个地方改名叫朱雀村，想不到一个美好的传说，到了恶人那里，却歪曲成了邪恶的谣言。倭寇贪欲太重，想要妄统世界，真是痴人说梦了。","setting":3,"mapId":955,"npcId":30,"radarMapID":0,"dialogNotStartNotReady":"你未完成相关任务","dialogStartNotFinish":"","dialogStartFinish":"今天虽击败了倭寇，但我希望不要再有“第二”，“第三个倭寇”出现。人类少些贪欲，这世界将会多么美好呀。/c00FF00{1}/p这是我的谢礼，你务必要收下。/cff0000【建军节即将到来，让我们在这里感谢那些守护着我们的军人。他们奉献了青春，奉献了生命来守护国家。】/p","exp":5000,"money2":0,"money3":0,"rewardItems":[{"illusion":[],"id":1422,"quantity":1,"name":"歼灭日寇奖励","bagIcon":7,"grade":3}],"selectItems":[{"illusion":[],"id":40001,"quantity":1,"name":"鉴定卷轴(绑）","bagIcon":79,"grade":1,"type":28},{"illusion":[],"id":40021,"quantity":1,"name":"装备强化卷(绑）","bagIcon":82,"grade":4,"type":33}],"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0392000fe587bbe8b4a5e580ade5af87e5869b","missionId":914,"name":"击败倭寇军"},{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"32","minimum":50},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0392000fe587bbe8b4a5e580ade5af87e5869b","missionId":914,"name":"击败倭寇军"}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":955,"acceptNpcId":30,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":87175,"protocol":14501,"sha256":"e3e46bcf6b2cd1a9cc9d387ba82725f712d5c7d02dd459ebb39cff6e60fbac52","blob":"blobs/e3/e3e46bcf6b2cd1a9cc9d387ba82725f712d5c7d02dd459ebb39cff6e60fbac52.bin","npcId":30,"mapId":955},{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":101409,"protocol":14501,"sha256":"e3e46bcf6b2cd1a9cc9d387ba82725f712d5c7d02dd459ebb39cff6e60fbac52","blob":"blobs/e3/e3e46bcf6b2cd1a9cc9d387ba82725f712d5c7d02dd459ebb39cff6e60fbac5