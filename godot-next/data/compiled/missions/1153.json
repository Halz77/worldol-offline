[{"id":1153,"name":"槛外人","level":0,"simpleDesc":"哈哈，我的话太多了，快随我找师父去吧。","desc":"别看我乃一介秀才，我可是带发修行的道家弟子。不瞒你说，我有一位道行高深的师父，如闲云野鹤，无拘无束，他听闻最近璧山里有许多戾气，便前来净化。虽然我师父法力高强，但年事已高，我很担心他一人是否能应对妖魔邪物，我看你一副热心肠的样子，就帮我师父一把吧。走，找师父去！","setting":5378,"mapId":7,"npcId":11,"radarMapID":7,"radarGx":26,"radarGy":9,"dialogNotStartNotReady":"","dialogStartNotFinish":"哈哈，我的话太多了，快随我找师父去吧。","dialogStartFinish":"“每个人身上都背负着各种罪，那些罪是不会消失的，但是有些事却非做不可。你好，贫道法号槛外人。”","exp":0,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":1163,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"048d0006e6849fe8b0a2","missionId":1165,"name":"感谢"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":1,"series":"秀才杜时雨","acceptMapId":7,"acceptNpcId":24,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":51345,"protocol":14501,"sha256":"6aa63c467df9a09daa39897fcb5e27aacbcd2b708c3be45f0dcf7611d337b606","blob":"blobs/6a/6aa63c467df9a09daa39897fcb5e27aacbcd2b708c3be45f0dcf7611d337b606.bin","npcId":24,"mapId":7}]}]