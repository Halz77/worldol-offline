[{"id":1163,"name":"拜祭先祖","level":0,"simpleDesc":"","desc":"璧山近日来，烟雾缭绕，实在不是好兆头，我正观察这山中的妖邪之气，希望能找出些眉目，把它驱除。对啦，时雨，你拜祭先祖了吗？清明可不能忘记这头等大事，快向着天地跪拜吧！（徒儿遵命！/c00FF00{1}/p，随我一起去祭拜吧，顺便观赏一下这山上的风景。）","setting":5378,"mapId":7,"npcId":12,"radarMapID":7,"radarGx":29,"radarGy":2,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"你四处张望，这里确实风光迤逦。","exp":0,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":1154,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"04810009e6a79be5a496e4baba","missionId":1153,"name":"槛外人"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":1,"series":"秀才杜时雨","acceptMapId":7,"acceptNpcId":11,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":51707,"protocol":14501,"sha256":"03967f58b1ff5bf8d91138d700e7144bf034768cfda2c558e5cf25af6243c6ff","blob":"blobs/03/03967f58b1ff5bf8d91138d700e7144bf034768cfda2c558e5cf25af6243c6ff.bin","npcId":11,"mapId":7}]}]