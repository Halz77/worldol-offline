[{"id":574,"name":"黑魔一族的过去","level":40,"simpleDesc":"继续与 /cff0000村民/p 对话","desc":"/cff0000黑魔一族/p 是早已被世人遗忘的种族。他们拥有极为强大的魔力，但是这股力量却被某些人认为会危害到世界。后来，他们一族被人们联合起来围剿，只剩下一些老弱妇孺存活下来。","setting":1027,"mapId":926,"npcId":102,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"多年以后，当年存活下来的小孩早已长大成人，并且拥有了极为强大的力量。他们隐居在森林深处的 /cffffff黑月之塔/p，只是塔内常常有怪物的叫声传出，所以我们一般不敢靠近。","exp":2000,"money2":0,"money3":250,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":575,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"023d0015e5a194e4b8ade8b791e587bae79a84e680aae789a9","missionId":573,"name":"塔中跑出的怪物"},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"023d0015e5a194e4b8ade8b791e587bae79a84e680aae789a9","missionId":573,"name":"塔中跑出的怪物"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":926,"acceptNpcId":102,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":36521,"protocol":14501,"sha256":"24e09dbc783d81e1d19756e7cd89e49016c834b4892941346e705ea60d553525","blob":"blobs/24/24e09dbc783d81e1d19756e7cd89e49016c834b4892941346e705ea60d553525.bin","npcId":102,"mapId":926}]}]