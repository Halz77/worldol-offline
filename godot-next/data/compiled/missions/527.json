[{"id":527,"name":"小村落的故事","level":0,"simpleDesc":"继续与 /cff0000村女/p 对话。","desc":"你知道吗？很久以前在这里附近有一条小村落，住着一群善良的村民，他们虽然贫困，但是却生活的很开心。只是后来有一天，食人魔出现在村子里，并且残忍的夺走了他们的性命。","setting":1027,"mapId":922,"npcId":103,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"死去的村民受到食人魔的诅咒，化成了充满怨恨的幽灵，常常出现在雪山袭击路过的行人。（/cFFFF00村女的脸上露出一丝诡异的笑容。/p）","exp":1000,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":528,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"020e0012e8a2abe68a93e4bd8fe79a84e5a5b3e5ad90","missionId":526,"name":"被抓住的女子"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":922,"acceptNpcId":103,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":25341,"protocol":14501,"sha256":"5eabcb06b9597adcda997b19a0e3b88c273c2afda78dc8df61c7e8ef7a0eb091","blob":"blobs/5e/5eabcb06b9597adcda997b19a0e3b88c273c2afda78dc8df61c7e8ef7a0eb091.bin","npcId":103,"mapId":922}]}]