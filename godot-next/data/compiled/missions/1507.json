[{"id":1507,"name":"疯狂的源头","level":0,"simpleDesc":"跟游民首领说话","desc":"好吧，我愿意相信你。这一切疯狂的源头，都来自与沙漠中那个突然出现的巨热洞穴，它使沙漠中所有的生物都变得疯狂。就连我的族人，也失去了一切理智。他们疯狂攻击所有陌生的旅人。","setting":1027,"mapId":819,"npcId":17,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"只要破坏了那个洞穴，沙漠中的一切便可以恢复正常……陌生人，听完这些，你还愿意帮我吗？","exp":5000,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":8,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"05e2000fe6b8b8e6b091e79a84e890a5e59cb0","missionId":1506,"name":"游民的营地"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":819,"acceptNpcId":17,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":33128,"protocol":14501,"sha256":"649ac94c9854d04372ee89e32fe8fcffe91192728bf34ce2c14ec445ea190a4d","blob":"blobs/64/649ac94c9854d04372ee89e32fe8fcffe91192728bf34ce2c14ec445ea190a4d.bin","npcId":17,"mapId":819}]}]