[{"id":596,"name":"疯掉的领袖","level":45,"simpleDesc":"继续与 /cff0000黑魔守护者/p 对话","desc":"可怜的外族人，你为何要选择这时候进入黑月之塔？这里已经成为了诅咒之地。我们黑魔一族的领袖 /cff0000黑魔导师/p 自从他的妻子被杀死后，就变成了一个彻头彻尾的疯子。","setting":1027,"mapId":928,"npcId":101,"radarMapID":0,"dialogNotStartNotReady":"45级以上角色,才可以承接这里的任务了.","dialogStartNotFinish":"","dialogStartFinish":"黑魔导师开始学习禁忌的召唤术，妄图把妻子的灵魂召唤回现实。但实际上每次召唤出来的都是地狱中的魔兽，塔中越来越多的魔兽就是被 /cff0000黑魔导师/p 召唤出来的。","exp":2000,"money2":0,"money3":250,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":597,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"02530015e9bb91e69c88e4b98be5a194e79a84e585a5e58fa3","missionId":595,"name":"黑月之塔的入口"},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"02530015e9bb91e69c88e4b98be5a194e79a84e585a5e58fa3","missionId":595,"name":"黑月之塔的入口"},{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"2d","minimum":45}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":928,"acceptNpcId":101,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":37794,"protocol":14501,"sha256":"dad8a013f74caef6258a61d894d7e8258e5891a1d2fd1f7bb0bb52acac3aa816","blob":"blobs/da/dad8a013f74caef6258a61d894d7e8258e5891a1d2fd1f7bb0bb52acac3aa816.bin","npcId":101,"mapId":928}]}]