[{"id":71,"name":"沙漠上的尸体","level":0,"simpleDesc":"找到沙漠上游民的尸体","desc":"相信你也看到了，我的族人遭受到了这些疯狂的生物的袭击。他们的尸体成为了那些秃鹰的饵食，我可不希望我的同伴继续曝尸在戈壁上。尽力找到戈壁上/c00ff00游民的尸体/p，好好安葬他们。","setting":5122,"mapId":820,"npcId":30,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"（你找到了游民的尸体，尸体上有明显的箭伤。）","exp":5000,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":72,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0bd20015e8b5a4e7828ee68888e5a381e79a84e5bc82e58f98","missionId":3026,"name":"赤炎戈壁的异变"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":820,"acceptNpcId":5,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":30082,"protocol":14501,"sha256":"3d7e6c9e67807a914d87c86456173f935d0403af67274c0433725884b2cdca1b","blob":"blobs/3d/3d7e6c9e67807a914d87c86456173f935d0403af67274c0433725884b2cdca1b.bin","npcId":5,"mapId":820}]}]