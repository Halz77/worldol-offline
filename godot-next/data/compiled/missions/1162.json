[{"id":1162,"name":"凄凉身世","level":0,"simpleDesc":"/cFFFFFF这是我生前的玉佩，我便是附身于此，才得以存在的，请你帮我埋葬在桃花树下吧。/p","desc":"5555，小女子本叫惜玉，乃苏州人氏，出身官宦人家，然家道中落，不得已流落到此，岂料中途遇上强盗，把我抢劫一空，还要了我性命。我心中有恨，死不瞑目，便化作厉鬼杀了那帮强盗，仇虽然是报了，我却因为此孽而无法升天，只得徘徊于人世。多亏了道长和你的搭救，我的戾气才得以消除。","setting":5379,"mapId":7,"npcId":16,"radarMapID":7,"radarGx":31,"radarGy":16,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"/cFFFFFF这是我生前的玉佩，我便是附身于此，才得以存在的，请你帮我埋葬在桃花树下吧。/p","exp":0,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":1160,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"04890009e6bf80e68898efbc81","missionId":1161,"name":"激战！"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":1,"series":"秀才杜时雨","acceptMapId":7,"acceptNpcId":16,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":51953,"protocol":14501,"sha256":"19aaba18d90ed12d1711ca1d826bcded85ca451d40ea22b46d6da57bebe6ec0f","blob":"blobs/19/19aaba18d90ed12d1711ca1d826bcded85ca451d40ea22b46d6da57bebe6ec0f.bin","npcId":16,"mapId":7}]}]