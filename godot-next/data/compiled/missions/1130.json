[{"id":1130,"name":"真相大白","level":0,"simpleDesc":"","desc":"海伦殿下本是/cFFFFFF天后赫拉的侍女，因太过貌美，而在仙界引发了一起骚乱。赫拉为免更大的纷争，而把海伦殿下下放到人间，刚好就流落到特洛伊。/p海伦殿下能歌善舞，聪敏至极，很快便俘获了王子的心，可惜王子太过沉溺于爱情，以致荒废国事，我虽曾进言，却丝毫不起作用。","setting":5378,"mapId":265,"npcId":8,"radarMapID":0,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"就在前不久，邻国的/cff0000塔洛斯国王/p前来拜访王子，无意中听到海伦殿下的歌声，虽未见人，但闻其声，已把国王迷得神魂颠倒，顿起抢夺之心。本就对特洛伊财富觊觎已久的塔洛斯，便发起了战争，特洛伊虽富饶一方，军事上却无建树，节节败退。于是我便用法术把海伦殿下送到另一个时空，希望能断了塔洛斯的念想，让他退兵。但现在。。这计划是失败了。","exp":0,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":1135,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"04690009e7a5ade5b888efbc9f","missionId":1129,"name":"祭师？"}],"type":1,"series":"美女节","acceptMapId":265,"acceptNpcId":8,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":44560,"protocol":14501,"sha256":"16a7639ed319383ad42128884e39cd92d1d32c48b19d1847de545e05fea3dcae","blob":"blobs/16/16a7639ed319383ad42128884e39cd92d1d32c48b19d1847de545e05fea3dcae.bin","npcId":8,"mapId":265}]}]