[{"id":3020,"name":"与太阳之城的联系","level":0,"simpleDesc":"通过飞行驿站前往太阳之城，与城守见面。看是否能与领主面谈。","desc":"大人！我们城市虽然已经成立，但目前势单力薄。我们需要建立与世界上各大势力的联系，与他们组成联盟关系，以在未来的危机与战争中，获取更大的优势。我们首先目标是西方的主要城市太阳之城。但他们的领主对外人态度恶劣是世界闻名的，我们的几位使者都被赶回来了。能麻烦你跑一趟吗？","setting":1024,"mapId":906,"npcId":0,"radarMapID":906,"radarGx":12,"radarGy":11,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"恩？领主大人？他很忙，没有空见你。我才不管你是谁。每天有上百个人来这里说要见领主呢。太阳之城领主只与有实力的英雄打交道。除非你能证明你的实力。","exp":500,"money2":0,"money3":0,"acceptJumpMapID":906,"acceptJumpMapGx":15,"acceptJumpMapGy":12,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":2546,"acceptCondition":[{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"0a","minimum":10},{"type":31,"typeName":"CONDITION_CITY_ISMASTER","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":2800,"acceptNpcId":2,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T01-15-00-654Z_dc48ca","seq":11706,"protocol":14501,"sha256":"a32c7fb4201696d8cb4aeccad52aa55346f2ce63055f4809e9f91dafad00833f","blob":"blobs/a3/a32c7fb4201696d8cb4aeccad52aa55346f2ce63055f4809e9f91dafad00833f.bin","npcId":3,"mapId":1000}]}]