[{"id":3022,"name":"消灭恐怖的秃鹫群","level":0,"simpleDesc":"击杀20只秃鹫，并且驱赶剩余的吧。以免他们再攻击路人。","desc":"秃鹫本来是些生活在戈壁和沙漠地区的生物，他们总是耐心的等待猎物死亡后，再进食尸体的。然而最近却变得异常凶恶，他们似乎都是呈现极度饥饿的状态，他们会攻击任何一个过路的人类。而且在目标没死亡之前就开始生吃进食，非常恐怖。可能的话，请协助我们减少秃鹫的数量吧。","setting":5378,"mapId":820,"npcId":60,"radarMapID":820,"radarGx":27,"radarGy":8,"dialogNotStartNotReady":"","dialogStartNotFinish":"击杀20只秃鹫，并且驱赶剩余的吧。以免他们再攻击路人。","dialogStartFinish":"谢谢，这样就足够了，我并不想杀光他们。秃鹫也算是很好的清道夫。否则满戈壁都是各种腐烂尸体没人处理的话，我也会很头疼。","exp":10000,"money2":0,"money3":1000,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":3023,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0bcd0015e5a4b1e9ad82e6b299e6bca0e79a84e781bee99abe","missionId":3021,"name":"失魂沙漠的灾难"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":820,"acceptNpcId":5,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":30082,"protocol":14501,"sha256":"3d7e6c9e67807a914d87c86456173f935d0403af67274c0433725884b2cdca1b","blob":"blobs/3d/3d7e6c9e67807a914d87c86456173f935d0403af67274c0433725884b2cdca1b.bin","npcId":5,"mapId":820}]}]