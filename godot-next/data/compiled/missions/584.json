[{"id":584,"name":"长翅膀的狮子","level":40,"simpleDesc":"消灭 /cff0000翼狮/p，然后让村民带路去黑月之塔。","desc":"/cff0000翼狮/p 是传说中专门吞噬人类灵魂的地狱凶兽。黑魔一族把它从地狱中召唤出来后，它们就聚集在下方的树林，袭击路过的行人。我可不想被那些怪物吞噬灵魂，消灭 /cff0000翼狮/p，我再考虑带你去黑月之塔。","setting":5378,"mapId":927,"npcId":101,"radarMapID":927,"radarGx":21,"radarGy":31,"dialogNotStartNotReady":"","dialogStartNotFinish":"我可不想碰到那些怪物，消灭 /cff0000翼狮/p，我才考虑带你去黑月之塔。","dialogStartFinish":"过于强大的魔力让 /cff0000黑魔一族/p 被世人唾弃，同时也让他们心里对那些仇视他们的外族人产生了极大的仇恨。","exp":20000,"money2":0,"money3":3000,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":585,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0247000fe680aae789a9e79a84e6a3aee69e97","missionId":583,"name":"怪物的森林"},{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0247000fe680aae789a9e79a84e6a3aee69e97","missionId":583,"name":"怪物的森林"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":2,"typeName":"CONDITION_KILL_MONSTER","not":0,"rawHex":"01f00006e7bfbce78bae1200","monsterId":496,"name":"翼狮","required":18,"current":0},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":927,"acceptNpcId":101,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":37110,"protocol":14501,"sha256":"1adab7deb57c78c26271de243e5228d8b9fc20097997bb241d6619d9360b5537","blob":"blobs/1a/1adab7deb57c78c26271de243e5228d8b9fc20097997bb241d6619d9360b5537.bin","npcId":101,"mapId":927}]}]