[{"id":1143,"name":"狂暴花仙子？","level":0,"simpleDesc":"寻找/cff0000花仙子/p。","desc":"前些日子我在村里最大的一棵古榕树上做了一个小木屋准备送给我的妻儿，给他们一个惊喜，但不知为何，原本温柔善良的/cff0000花仙子们/p竟把我的木屋霸为己有，还把榕树给砍掉。我的计划便这么泡汤了，心情真差呀。（花仙子？你眼珠转动着，脑子里又浮现出冻害那张抽搐的脸。）","setting":5378,"mapId":20,"npcId":19,"radarMapID":20,"radarGx":19,"radarGy":30,"dialogNotStartNotReady":"","dialogStartNotFinish":"寻找/cff0000花仙子/p。","dialogStartFinish":"花仙子们走了么？（你把事实真相告诉小狸。）原来一切都是冻害做的，想不到他圆滚滚，却这么心肠歹毒。","exp":0,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":1145,"acceptCondition":[{"type":10,"typeName":"CONDITION_MISSION_DOING","not":0,"rawHex":"04740012e58fafe6809ce79a84e5b08fe58aa8e789a9","missionId":1140,"name":"可怜的小动物"}],"submitCondition":[{"type":2,"typeName":"CONDITION_KILL_MONSTER","not":0,"rawHex":"001c0009e88ab1e4bb99e5ad900900","monsterId":28,"name":"花仙子","required":9,"current":0}],"type":0,"series":"","acceptMapId":20,"acceptNpcId":19,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":47718,"protocol":14501,"sha256":"8b36b5a19ec1ed32acd8cd4dbc7629b7bcc5da2be70c945bdf390f4a33feacec","blob":"blobs/8b/8b36b5a19ec1ed32acd8cd4dbc7629b7bcc5da2be70c945bdf390f4a33feacec.bin","npcId":19,"mapId":20}]}]