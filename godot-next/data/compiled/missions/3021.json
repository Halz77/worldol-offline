[{"id":3021,"name":"失魂沙漠的灾难","level":0,"simpleDesc":"前往戈壁地区，协助游牧民族代表解决问题。","desc":"你好。我是/c00ff00赤炎戈壁地区/p生活的游牧民族。我们长期为路过戈壁地区和沙漠的商旅提供导游和保卫工作。但最近在沙漠出现的怪物越来越多了。连续的袭击和交战已经令我们族人损失惨重。我们寻求雷州镇救援和帮助，遭到拒绝。实在没有办法了，希望你能伸出援手，解决这些怪物。","setting":1026,"mapId":820,"npcId":5,"radarMapID":0,"dialogNotStartNotReady":"35级后开启后续主线任务","dialogStartNotFinish":"","dialogStartFinish":"感谢/c00FF00{1}大人/p！谢谢你伸出援手。如你所见，这里到处都是怪物，我们实在没有办法了。","exp":2000,"money2":0,"money3":0,"acceptJumpMapID":820,"acceptJumpMapGx":18,"acceptJumpMapGy":6,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":3022,"acceptCondition":[{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"23","minimum":35},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":5,"acceptNpcId":44,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"seq":5572,"protocol":14501,"sha256":"ecc37de0ec5f943b655921286da2fab2abcd57eff66774b35343e6df2565eb37","blob":"blobs/ec/ecc37de0ec5f943b655921286da2fab2abcd57eff66774b35343e6df2565eb37.bin","npcId":44,"mapId":5},{"capture":"2026-09-19T23-46-03-133Z_d6e6ad","seq":5572,"protocol":14501,"sha256":"ecc37de0ec5f943b655921286da2fab2abcd57eff66774b35343e6df2565eb37","blob":"blobs/ec/ecc37de0ec5f943b655921286da2fab2abcd57eff66774b35343e6df2565eb37.bin","npcId":44,"mapId":5},{"capture":"2026-09-20T15-38-00-452Z_eb21b9","seq":1990,"protocol":14501,"sha256":"0c7c3ef0c9d23a4d5e6ea17cccebd77cd4c97cf1fc65d1849952edc52b2818ec","blob":"blobs/0c/0c7c3ef0c9d23a4d5e6ea17cccebd77cd4c97cf1fc65d1849952edc52b2818ec.bin","npcId":44,"mapId":5},{"capture":"2026-09-20T15-38-00-452Z_eb21b9","seq":12017,"protocol":14501,"sha256":"ecc37de0ec5f943b655921286da2fab2abcd57eff66774b35343e6df2565eb37","blob":