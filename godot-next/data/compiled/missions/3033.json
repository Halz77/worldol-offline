[{"id":3033,"name":"40级无双任务","level":40,"simpleDesc":"","desc":"/c00FF00{1}/p大人！我们发现了残余的邪灵教团部队。是否对他们发动袭击？启动这个任务将需要支付押金。完成该任务后，将退还全部押金。如果任务失败，则无法退还，请留意。本任务只允许单人进行。不会被其他玩家破坏。/c00FF00无双任务中，拥有大量的怪物，他们虽然不堪一击，攻击力也非常弱，但数量庞大。你必须确保自己拥有足够的恢复能力和药品。否则将会陷于困境。击杀这些怪物，均有机会掉落装备，包括稀有、史诗级装备、以及任务专有的单件装备。请确保参加任务前，你的背包有足够空位。/p","setting":98,"mapId":2800,"npcId":55,"radarMapID":0,"dialogNotStartNotReady":"只有城市主人，并且身上携带有“无双任务卷”时，才可以启动这个任务。","dialogStartNotFinish":"","dialogStartFinish":"","exp":4000,"money2":0,"money3":0,"escortCost":[0,0,50000],"acceptCondition":[{"type":7,"typeName":"CONDITION_HAVE_ITEM","not":0,"rawHex":"000002ce000fe697a0e58f8ce4bbbbe58aa1e58db701","itemId":718,"name":"无双任务卷","required":1},{"type":1,"typeName":"CONDITION_LEVEL","not":0,"rawHex":"28","minimum":40},{"type":31,"typeName":"CONDITION_CITY_ISMASTER","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":2800,"acceptNpcId":0,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"seq":828,"protocol":14501,"sha256":"ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3","blob":"blobs/ea/ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3.bin","npcId":1,"mapId":3090},{"capture":"2026-09-20T01-15-00-654Z_dc48ca","seq":12488,"protocol":14501,"sha256":"ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3","blob":"blobs/ea/ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3.bin","npcId":1,"mapId":1000},{"capture":"2026-09-19T23-46-03-133Z_d6e6ad","seq":828,"protocol":14501,"sha256":"ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3","blob":"blobs/ea/ea35a82c079f851d2d9bc2be07cb878e1b8012083bcf435a441fa336e1dc34d3.bin","npcId":1,"mapId":3090},{"capture":"2026-09-21T01-33-38-380Z_0dc594","seq":4548,"protocol":14501,"sha256":"ea35a82c079f851d2d9bc2be07cb878