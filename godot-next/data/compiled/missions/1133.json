[{"id":1133,"name":"和谈","level":0,"simpleDesc":"","desc":"海伦？眼前的您真是明艳动人，任何花儿瞬间都失了颜色。为了您，我可以做任何事。/cFFFFFF（“尊敬的塔洛斯陛下，请结束这场战争吧，我不愿两国人民陷入长久的战争之中，和平才是最重要的。”）/p但这一切岂能就这么结束？海伦，撤兵可不是一件容易事，我得给我的人民一个交代。（/cff0000打败塔洛斯/p，你将有机会阻止这场战争，对话结束后，战斗开始。）","setting":5378,"mapId":265,"npcId":24,"radarMapID":265,"radarGx":8,"radarGy":13,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"哈哈哈，（塔洛斯仰天长笑），/c00FF00{1}/p，想不到你还有如此本领，好，一切都听你们的，我这便撤兵。我美丽而尊贵的海伦，我答应您，从此不再侵犯特洛伊，两国结为友盟。","exp":10000,"money2":0,"money3":1000,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":64,"submitBattleID":0,"submitNextMissionID":1132,"rewardItems":[{"illusion":[],"id":15128,"quantity":1,"name":"美女节时装(2天)","bagIcon":11,"grade":3},{"illusion":[],"id":40047,"quantity":1,"name":"宠物经验卷(30000）","bagIcon":29,"grade":3}],"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0470000fe5a194e6b49be696afe59bbde78e8b","missionId":1136,"name":"塔洛斯国王"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":2,"typeName":"CONDITION_KILL_MONSTER","not":0,"rawHex":"0019000fe5a194e6b49be696afe59bbde78e8b0100","monsterId":25,"name":"塔洛斯国王","required":1,"current":0},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":1,"series":"美女节","acceptMapId":265,"acceptNpcId":24,"canAccept":1,"_isHelp":true,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":45670,"protocol":14501,"sha256":"a670f9460369e7f9771cc3fe57d958106eed05a9425b796bb0c25cb1740d0f09","blob":"blobs/a6/a670f9460369e7f9771cc3fe57d958106eed05a9425b796bb0c25cb1740d0f09.bin","npcId":24,"mapId":265}]}]