[{"id":331,"name":"路途凶险","level":0,"simpleDesc":"和天玄剑客对话","desc":"经过刚才的战斗，我想你肯定能明白，前方路途凶险万分。你确定要继续随我前进吗？（/c00FF00你默默点头。/p）那就随我来吧。我会在路上跟你解释这里发生的一切。","setting":5122,"mapId":22,"npcId":17,"radarMapID":22,"radarGx":29,"radarGy":22,"dialogNotStartNotReady":"","dialogStartNotFinish":"","dialogStartFinish":"以妖王为首的妖怪占领了这座矿山。但这座月牙山原是雷州镇百姓赖以为生的矿山，为了夺回矿山，才多次派人讨伐。只是之前的那些“勇士”，大多连/cFF0000狼人/p都斗不过，在这里白送了性命。","exp":100,"money2":0,"money3":0,"acceptJumpMapID":0,"submitJumpMapID":0,"acceptBattleID":0,"submitBattleID":0,"submitNextMissionID":303,"acceptCondition":[{"type":9,"typeName":"CONDITION_MISSION_DONE","not":0,"rawHex":"0136000ce9a5bfe78bbce59bb4e694bb","missionId":310,"name":"饿狼围攻"},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"submitCondition":[{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""},{"type":0,"typeName":"CONDITION_NONE","not":0,"rawHex":""}],"type":0,"series":"","acceptMapId":22,"acceptNpcId":3,"canAccept":1,"_isHelp":false,"wireBase64":"","sources":[{"capture":"2026-09-20T23-27-15-970Z_874aae","seq":14852,"protocol":14501,"sha256":"803f7891bcd9e324fd64c11ad183873a8376800daa15808adfcdf9c3f74bab20","blob":"blobs/80/803f7891bcd9e324fd64c11ad183873a8376800daa15808adfcdf9c3f74bab20.bin","npcId":3,"mapId":22}]}]